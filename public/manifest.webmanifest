{
  "id": "/",
  "name": "Forkful: food diary and calorie counter",
  "short_name": "Forkful",
  "description": "Track meals, calories, macros, water, exercise and weight. Your data stays on your phone.",
  "start_url": "/#/",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#f3f5f2",
  "theme_color": "#12a150",
  "categories": ["health", "fitness", "food"],
  "icons": [
    { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Log food", "url": "/#/add", "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] },
    { "name": "Scan barcode", "url": "/#/add?scan=1", "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] },
    { "name": "Diary", "url": "/#/diary", "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] }
  ]
}
